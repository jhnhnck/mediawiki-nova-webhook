{
	"@metadata": {
		"authors": [
			"Jayden Bailey",
            "John Hancock"
		]
	},
	"novawebhook-desc": "Sends wiki events to Discord and structured JSON webhook receivers",
	"novawebhook-userlinks": "$1 ($2|$3)",
	"novawebhook-revisionlinks": "($1) $2 $3",
	"novawebhook-talk": "t",
	"novawebhook-contribs": "c",
	"novawebhook-diff": "diff",
	"novawebhook-minor": "(m)",
	"novawebhook-size": "($1)",
	"novawebhook-edit": "$1 edited $2 $3 $4",
	"novawebhook-create": "$1 created $2 $3 $4",
	"novawebhook-articledelete": "$1 deleted $2 $3 ($4 revisions deleted)",
	"novawebhook-undeleterev": "revisions for",
	"novawebhook-articleundelete": "$1 undeleted $2 $3 $4",
	"novawebhook-revvisibility": "$1 changed visibility of $2 revisions on $3",
	"novawebhook-articleprotect": "$1 changed protection of $2 $3 ($4)",
	"novawebhook-titlemove": "$1 moved $2 to $3 $4 $5",
	"novawebhook-localusercreated": "$1 registered",
	"novawebhook-blocktimeformat": "d F Y H:i",
	"novawebhook-blockipcomplete": "$1 blocked $2 $3 ($4)",
	"novawebhook-unblockusercomplete": "$1 unblocked $2",
	"novawebhook-usergroupschanged": "$1 changed rights of $2 $3 ($4) ($5)",
	"novawebhook-uploadnewver": "new version of",
	"novawebhook-uploadcomplete": "$1 uploaded $2 $3 $4 ($5, $6x$7, $8)",
	"novawebhook-filedeletecomplete": "$1 deleted a version of file $2 $3",
	"novawebhook-fileundeletecomplete": "$1 restored some versions of file $2 $3",
	"novawebhook-afterimportpage": "$1 imported $2 (imported $4/$3 revisions)",
	"novawebhook-timestampformat": "<t:$1:T>",
	"novawebhook-articlemergecomplete": "$1 merged revisions from $2 into $3",
	"novawebhook-renameusercomplete": "$1 renamed the user $2 to $3"
}
